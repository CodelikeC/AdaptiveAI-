{
    "$schema": "https://aicp-schema/AdaptiveAI-/v1",
    "version": "1.0.0",
    "types": {
        "STATE_UPDATE": {
            "required": ["type", "timestamp", "state"],
            "properties": {
                "type": "STATE_UPDATE",
                "timestamp": "integer",
                "state": "object"
            }
        },
        "EVENT": {
            "required": ["type", "timestamp", "event_id"],
            "properties": {
                "type": "EVENT",
                "event_id": "string",
                "payload": "object"
            }
        },
        "LOG": {
            "required": ["type", "level", "message"],
            "properties": {
                "type": "LOG",
                "level": "string",
                "message": "string"
            }
        }
    }
}

